<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoySklad solution descriptor for the Didox integration MVP.
  Paste this into the descriptor field in Личный кабинет разработчика.

  Replace https://your-server.example.com with your real public HTTPS URL.
  It must match PUBLIC_BASE_URL in your .env file.

  Permissions reflect what a Didox EDI plugin minimally needs to read documents
  and counterparties to build outgoing invoices. Tighten or expand as you build
  out features.
-->
<ServerApplication xmlns="https://apps-api.moysklad.ru/xml/ns/appstore/app/v2"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="https://apps-api.moysklad.ru/xml/ns/appstore/app/v2
                                       https://apps-api.moysklad.ru/xml/ns/appstore/app/v2/application-v2.xsd">

  <iframes>
    <iframe type="main"
            sourceUrl="https://test-domain.uzpos.uz/settings/iframe">
      <uses>
        <standard-dialogs/>
      </uses>
    </iframe>
  </iframes>

  <!--
    Buttons (flow.md §4):
      - "Импорт из Didox" on the Счета поставщиков list (Didox → MoySklad).
        Inbound path; creates `invoicein` documents from incoming facturas.
      - "Отправить в Didox" on the Счета покупателям list (MoySklad → Didox).
        Outbound path; selected invoiceouts are converted and posted to Didox.

    Both POST to {endpointBase}/api/moysklad/vendor/1.0/apps/{appId}/{accountId}/button
    with { "buttonName": <name>, ... }.

    useSelected="true" on send-to-didox so MoySklad passes the selected row ids
    in the click payload — required by §6.1 (user picks one or more invoices).
  -->
  <buttons>
    <button name="import-from-didox" title="Импорт из Didox" useSelected="false">
      <locations>
        <document.invoicein.list/>
      </locations>
    </button>
    <button name="send-to-didox" title="Отправить в Didox" useSelected="true">
      <locations>
        <document.invoiceout.list/>
      </locations>
    </button>
  </buttons>

  <vendorApi>
    <endpointBase>https://test-domain.uzpos.uz</endpointBase>
  </vendorApi>

  <access>
    <resource>https://api.moysklad.ru/api/remap/1.2</resource>
    <scope>custom</scope>
    <permissions>
      <!-- Read counterparties (Didox needs INN/PINFL/OKED for the buyer) -->
      <company>
        <view/>
      </company>

      <!-- Read products and services for IKPU codes (mod__tasnif__uz.ikpu) -->
      <good>
        <view/>
      </good>

      <!-- The documents on the read/write paths to/from Didox. -->
      <demand>
        <view/>
      </demand>
      <supply>
        <view/>
      </supply>
      <!--
        Inbound (flow.md §5): we create Счёт поставщика from each Didox
        incoming factura. Need view (idempotency lookup) + create.
      -->
      <invoiceIn>
        <view/>
        <create/>
      </invoiceIn>
      <!--
        Outbound (flow.md §6): we read the user-selected invoices, send them
        to Didox, then stamp the source doc with the Didox id/status. Need
        view + update.
      -->
      <invoiceOut>
        <view/>
        <update/>
      </invoiceOut>

      <!-- Read own organization (for seller-side INN/OKED) -->
      <myCompany>
        <view/>
      </myCompany>

      <!-- Webhooks: create our own to listen for new/updated documents -->
      <useOwnWebhooks/>

      <!-- Custom attributes: we'll create our own for storing Didox status/ID -->
      <useOwnAttributeMetadata/>
    </permissions>
  </access>

</ServerApplication>
