# Server configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public base URL of your server (must be HTTPS in production)
# This must match endpointBase in your MoySklad descriptor
PUBLIC_BASE_URL=https://your-server.example.com

# MoySklad solution credentials (from Personal Cabinet → Solution → Учётные данные)
MOYSKLAD_APP_ID=00000000-0000-0000-0000-000000000000
MOYSKLAD_APP_UID=your-app.your-vendor
MOYSKLAD_SECRET_KEY=replace-with-real-secret-key-from-cabinet

# MoySklad Vendor API base URL (do not change in production)
MOYSKLAD_VENDOR_API_BASE=https://apps-api.moysklad.ru/api/vendor/1.0

# MoySklad JSON API base URL (do not change in production)
MOYSKLAD_JSON_API_BASE=https://api.moysklad.ru/api/remap/1.2

# JWT token lifetime for outgoing requests to MoySklad, in seconds
JWT_LIFETIME_SECONDS=60
